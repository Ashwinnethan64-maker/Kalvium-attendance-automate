# Kalvium Attendance Assistant Configuration

# Kalvium Dashboard URL
KALVIUM_DASHBOARD_URL=https://app.kalvium.community/dashboard

# Persistent browser profile directory (local, will preserve login session)
BROWSER_PROFILE_PATH=./.browser-profile

# Whether to run in headless mode (MUST BE false for human presence, live camera & manual login)
BROWSER_HEADLESS=false

# Default action timeout in milliseconds (e.g., 15000 = 15 seconds)
ACTION_TIMEOUT_MS=15000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory where failure screenshots are saved
SCREENSHOTS_DIR=./screenshots

# Feedback configuration ("positive", "neutral", "negative")
FEEDBACK_SENTIMENT=positive
FEEDBACK_OPTIONS=Mentor was well prepared,Mentor resolved my doubts,Session was engaging,Content was well-structured

# Polling and Monitoring intervals
POLL_INTERVAL_SEC=15
MAX_WAIT_MINUTES=60
