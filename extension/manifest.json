{
  "manifest_version": 3,
  "name": "Kalvium Attendance Assistant",
  "version": "1.0.0",
  "description": "Safe, verified session attendance and feedback assistant for the Kalvium student dashboard.",
  "permissions": [
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://app.kalvium.community/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://app.kalvium.community/*"],
      "js": [
        "shared/constants.js",
        "shared/logger.js",
        "shared/state.js",
        "content/attendance.js",
        "content/feedback.js",
        "content/kalvium.js"
      ],
      "run_at": "document_end"
    }
  ]
}
